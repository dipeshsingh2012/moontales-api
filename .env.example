# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/moontales

# Provider Selection (tts: "gcp" | "elevenlabs", llm: "gemini" | "openai" | "groq", image: "imagen" | "dalle" | "replicate")
TTS_PROVIDER=gcp
LLM_PROVIDER=gemini
IMAGE_PROVIDER=imagen

# Google AI (Gemini 2.0 Flash + Imagen 3)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# GCP Cloud Text-to-Speech
GCP_TTS_VOICE_NAME=en-US-Journey-F
GCP_TTS_LANGUAGE_CODE=en-US

# ElevenLabs (Optional if using GCP)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEFAULT_VOICE_ID=your_cloned_voice_id_here

# OpenAI (Optional if using Gemini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LLM_MODEL=gpt-4o-mini
DALL_E_MODEL=dall-e-3

# Groq (Optional if using Gemini)
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Replicate (Optional if using Imagen)
REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Google Cloud Storage
GCS_BUCKET_NAME=moontales-assets
GCS_PROJECT_ID=your_gcp_project_id

# Firebase Auth
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# App Config
APP_ENV=development
DEFAULT_PAGE_COUNT=5
SIGNED_URL_EXPIRY_HOURS=1
